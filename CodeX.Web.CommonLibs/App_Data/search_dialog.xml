<?xml version="1.0" encoding="utf-8" ?>
<root>
  <!-- #Region Business Partners -->
  <searchdialog type="businesspartners" methodname="GetBusinessPartnersList" keyfieldname="BusinessPartnerCode" orderbyexpression="BusinessPartnerName ASC">
    <gridcolumns>
      <gridcolumn datafield="BusinessPartnerCode" headertext="Kode" width="50px" />
      <gridcolumn datafield="BusinessPartnerName" headertext="Nama" width="300px" />
    </gridcolumns>
    <intellisensetexts>
      <intellisensetext datafield="BusinessPartnerName" headertext="Nama" description="" />
      <intellisensetext datafield="BusinessPartnerCode" headertext="Kode Instansi" description="" />
    </intellisensetexts>
  </searchdialog>
  <!-- #EndRegion -->
  <!-- #Region Item -->
  <searchdialog type="item" methodname="GetItemMasterList" keyfieldname="ItemCode" orderbyexpression="ItemName1 ASC">
    <gridcolumns>
      <gridcolumn datafield="ItemCode" headertext="Kode Item" width="100px" />
      <gridcolumn datafield="ItemName1" headertext="Nama Item" width="300px" />
    </gridcolumns>
    <intellisensetexts>
      <intellisensetext datafield="ItemName1" headertext="Nama Item" description="" />
      <intellisensetext datafield="ItemCode" headertext="Kode Item" description="" />
    </intellisensetexts>
  </searchdialog>
  <!-- #EndRegion -->
  <!-- #Region Item Alternate Unit -->
  <searchdialog type="itemalternateunit" methodname="GetvItemAlternateUnitList" keyfieldname="GCAlternateUnit">
    <gridcolumns>
      <gridcolumn datafield="AlternateUnit" headertext="Alternate Unit" width="100px" />
      <gridcolumn datafield="CustomConversion" headertext="Conversion" width="300px" />
    </gridcolumns>
    <intellisensetexts>
      <intellisensetext datafield="AlternateUnit" headertext="Alternate Unit" description="" />
      <intellisensetext datafield="CustomConversion" headertext="Conversion" description="" />
    </intellisensetexts>
  </searchdialog>
  <!-- #EndRegion -->
  <!-- #Region Item Balance -->
  <searchdialog type="itembalance" methodname="GetvItemBalanceList" keyfieldname="ItemCode">
    <gridcolumns>
      <gridcolumn datafield="ItemCode" headertext="Kode Item" width="100px" />
      <gridcolumn datafield="ItemName1" headertext="Nama Item" width="300px" />
    </gridcolumns>
    <intellisensetexts>
      <intellisensetext datafield="ItemName1" headertext="Nama Item" description="" />
      <intellisensetext datafield="ItemCode" headertext="Kode Item" description="" />
    </intellisensetexts>
  </searchdialog>
  <!-- #EndRegion -->
  <!-- #Region Item Distribution HD-->
  <searchdialog type="itemdistributionhd" methodname="GetvItemDistributionHdList" keyfieldname="DistributionNo" orderbyexpression="DistributionID DESC">
    <gridcolumns>
      <gridcolumn datafield="DistributionNo" headertext="No Distribusi" width="100px" />
      <gridcolumn datafield="DeliveryDateInString" displaycustomfield="DeliveryDateInString" horizontalalign="center" headertext="Transaction Date" width="100px" />
      <gridcolumn datafield="ToLocationName" headertext="Lokasi Tujuan" width="100px" />
      <gridcolumn datafield="DistributionStatus" headertext="Status" width="100px" />
    </gridcolumns>
    <intellisensetexts>
      <intellisensetext datafield="DistributionNo" headertext="No Distribusi" description="" />
      <intellisensetext datafield="DeliveryDateInString" headertext="DeliveryDateInString" description="" />
      <intellisensetext datafield="ToLocationName" headertext="Lokasi Tujuan" description="" />
      <intellisensetext datafield="DistributionStatus" headertext="Status" description="" />
    </intellisensetexts>
  </searchdialog>
  <!-- #EndRegion -->
  <!-- #Region Item Group -->
  <searchdialog type="itemgroup" methodname="GetvItemGroupMasterList" keyfieldname="ItemGroupCode" istreeview="1">
    <gridcolumns>
      <gridcolumn datafield="ItemGroupCode" headertext="Kode Kelompok Item" width="100px" />
      <gridcolumn datafield="ItemGroupName1" headertext="Nama Kelompok Item" width="300px" />
    </gridcolumns>
    <intellisensetexts>
      <intellisensetext datafield="ItemGroupName1" headertext="Nama Kelompok Item" description="" />
      <intellisensetext datafield="ItemGroupCode" headertext="Kode Kelompok Item" description="" />
    </intellisensetexts>
  </searchdialog>
  <!-- #EndRegion -->
  <!-- #Region Item Planning -->
  <searchdialog type="itemplaning" methodname="GetvSupplierItemPlaningList" keyfieldname="ItemCode">
    <gridcolumns>
      <gridcolumn datafield="ItemCode" headertext="Kode Item" width="100px" />
      <gridcolumn datafield="ItemName1" headertext="Nama Item" width="300px" />
    </gridcolumns>
    <intellisensetexts>
      <intellisensetext datafield="ItemName1" headertext="Nama Item" description="" />
      <intellisensetext datafield="ItemCode" headertext="Kode Item" description="" />
    </intellisensetexts>
  </searchdialog>
  <!-- #EndRegion -->
  <!-- #Region Item Production HD-->
  <searchdialog type="itemproductionhd" methodname="GetvItemProductionHdList" keyfieldname="ProductionNo" orderbyexpression="ProductionID DESC">
    <gridcolumns>
      <gridcolumn datafield="ProductionNo" headertext="No Produksi" width="100px" />
      <gridcolumn datafield="ProductionDate" displaycustomfield="ProductionDateInString" horizontalalign="center" headertext="Transaction Date" width="100px" />
      <gridcolumn datafield="FromLocationName" headertext="Dari Lokasi" width="100px" />
      <gridcolumn datafield="ToLocationName" headertext="Ke Lokasi" width="100px" />
      <gridcolumn datafield="ItemName1" headertext="Barang" width="100px" />
    </gridcolumns>
    <intellisensetexts>
      <intellisensetext datafield="ProductionNo" headertext="No Produksi" description="" />
      <intellisensetext datafield="ProductionDate" headertext="ProductionDateInString" description="" />
      <intellisensetext datafield="FromLocationName" headertext="Dari Lokasi" description="" />
      <intellisensetext datafield="ToLocationName" headertext="Ke Lokasi" description="" />
      <intellisensetext datafield="ItemName1" headertext="Barang" description="" />
    </intellisensetexts>
  </searchdialog>
  <!-- #EndRegion -->
  <!-- #Region Item Request HD-->
  <searchdialog type="itemrequesthd" methodname="GetvItemRequestHdList" keyfieldname="ItemRequestNo" orderbyexpression="ItemRequestID DESC">
    <gridcolumns>
      <gridcolumn datafield="ItemRequestNo" headertext="Permintaan No" width="100px" />
      <gridcolumn datafield="FromLocationName" headertext="Dari Lokasi" width="100px" />
      <gridcolumn datafield="ToLocationName" headertext="Ke Lokasi" width="100px" />
      <gridcolumn datafield="TransactionDate" displaycustomfield="TransactionDateInString" horizontalalign="center" headertext="Tanggal Permintaan" width="100px" />
      <gridcolumn datafield="Remarks" headertext="Keterangan" width="100px" />
    </gridcolumns>
    <intellisensetexts>
      <intellisensetext datafield="ItemRequestNo" headertext="Permintaan No" description="" />
      <intellisensetext datafield="FromLocationName" headertext="Dari Lokasi" description="" />
      <intellisensetext datafield="ToLocationName" headertext="Ke Lokasi" description="" />
      <intellisensetext datafield="TransactionDate" headertext="Tanggal Permintaan" description="" />
      <intellisensetext datafield="Remarks" headertext="Keterangan" description="" />
    </intellisensetexts>
  </searchdialog>
  <!-- #EndRegion -->
  <!-- #Region Item Transaction -->
  <searchdialog type="itemtransactionhd" methodname="GetvItemTransactionHdList" keyfieldname="TransactionNo" orderbyexpression="TransactionID DESC">
    <gridcolumns>
      <gridcolumn datafield="TransactionNo" headertext="Transaction No" width="100px" />
      <gridcolumn datafield="TransactionDateInString" headertext="Transaction Date" width="100px" horizontalalign="center" />
      <gridcolumn datafield="FromLocationName" headertext="Location" width="300px" />
    </gridcolumns>
    <intellisensetexts>
      <intellisensetext datafield="TransactionNo" headertext="Transaction No" description="" />
      <intellisensetext datafield="TransactionDateInString" headertext="Transaction Date" description="" />
      <intellisensetext datafield="FromLocationName" headertext="Location" description="" />
    </intellisensetexts>
  </searchdialog>
  <!-- #EndRegion -->
  <!-- #Region Location -->
  <searchdialog type="location" methodname="GetvLocationList" keyfieldname="LocationCode" istreeview="1">
    <gridcolumns>
      <gridcolumn datafield="LocationCode" headertext="Kode Lokasi" width="100px" />
      <gridcolumn datafield="LocationName" headertext="Nama Lokasi" width="300px" />
    </gridcolumns>
    <intellisensetexts>
      <intellisensetext datafield="LocationName" headertext="Nama Lokasi" description="" />
      <intellisensetext datafield="LocationCode" headertext="Kode Lokasi" description="" />
    </intellisensetexts>
  </searchdialog>
  <!-- #EndRegion -->
  <!-- #Region LocationPerRoleUser -->
  <searchdialog type="locationroleuser" methodname="GetLocationUserAccessList" keyfieldname="LocationCode">
    <gridcolumns>
      <gridcolumn datafield="LocationCode" headertext="Kode Lokasi" width="100px" />
      <gridcolumn datafield="LocationName" headertext="Nama Lokasi" width="300px" />
    </gridcolumns>
    <intellisensetexts>
      <intellisensetext datafield="LocationName" headertext="Nama Lokasi" description="" />
      <intellisensetext datafield="LocationCode" headertext="Kode Lokasi" description="" />
    </intellisensetexts>
  </searchdialog>
  <!-- #EndRegion -->
  <!-- #Region Menu -->
  <searchdialog type="menu" methodname="GetvMenuList" keyfieldname="MenuCode" istreeview="1">
    <gridcolumns>
      <gridcolumn datafield="MenuCode" headertext="Kode" width="100px" />
      <gridcolumn datafield="MenuCaption" headertext="Nama" width="300px" />
    </gridcolumns>
    <intellisensetexts>
      <intellisensetext datafield="MenuCaption" headertext="Nama" description="" />
      <intellisensetext datafield="MenuCode" headertext="Kode" description="" />
    </intellisensetexts>
  </searchdialog>
  <!-- #EndRegion -->
  <!-- #Region Site -->
  <searchdialog type="site" methodname="GetSiteList" keyfieldname="SiteID">
    <gridcolumns>
      <gridcolumn datafield="SiteID" headertext="Kode Rumah Sakit" width="100px" />
      <gridcolumn datafield="SiteName" headertext="Nama Rumah Sakit" width="300px" />
    </gridcolumns>
    <intellisensetexts>
      <intellisensetext datafield="SiteName" headertext="Nama Rumah Sakit" description="" />
      <intellisensetext datafield="SiteeID" headertext="Kode Rumah Sakit" description="" />
    </intellisensetexts>
  </searchdialog>
  <!-- #EndRegion -->
  <!-- #Region Standard Code -->
  <searchdialog type="stdcode" methodname="GetStandardCodeList" keyfieldname="cfStandardCodeID">
    <gridcolumns>
      <gridcolumn datafield="StandardCodeID" displaycustomfield="cfStandardCodeID" headertext="Kode" width="100px" />
      <gridcolumn datafield="StandardCodeName" headertext="Nama" width="300px" />
    </gridcolumns>
    <intellisensetexts>
      <intellisensetext datafield="StandardCodeName" headertext="Nama" description="" />
      <intellisensetext datafield="StandardCodeID" headertext="Kode" description="" />
    </intellisensetexts>
  </searchdialog>

  <searchdialog type="standardcodeheader" methodname="GetStandardCodeList" filterexpression="IsHeader = 1 AND IsDeleted = 0" keyfieldname="StandardCodeID">
    <gridcolumns>
      <gridcolumn datafield="StandardCodeID" headertext="Kode" width="100px" />
      <gridcolumn datafield="StandardCodeName" headertext="Nama" width="300px" />
    </gridcolumns>
    <intellisensetexts>
      <intellisensetext datafield="StandardCodeName" headertext="Nama" description="" />
      <intellisensetext datafield="StandardCodeID" headertext="Kode" description="" />
    </intellisensetexts>
  </searchdialog>

  <!-- #EndRegion -->
  <!-- #Region User-->
  <searchdialog type="user" methodname="GetvUserList" keyfieldname="UserID">
    <gridcolums>
      <gridcolumn datafield="UserName" headertext="UserName" width="100px" />
      <gridcolumn datafield="FullName" headertext="Nama" width="120px"/>
    </gridcolums>
    <intellisensetexts>
      <intellisensetext datafield="FullName" headertext="Nama" description="" />
      <intellisensetext datafield="UserName" headertext="UserName" description="" />
    </intellisensetexts>
  </searchdialog>
  <!-- #EndRegion-->
  <!-- #Region VisitType -->
  <searchdialog type="visittype" filterexpression="IsDeleted = 0" methodname="GetVisitTypeList" keyfieldname="VisitTypeCode">
    <gridcolumns>
      <gridcolumn datafield="VisitTypeCode" headertext="Kode" width="100px" />
      <gridcolumn datafield="VisitTypeName" headertext="Nama" width="300px" />
    </gridcolumns>
    <intellisensetexts>
      <intellisensetext datafield="VisitTypeName" headertext="Nama" description="" />
      <intellisensetext datafield="VisitTypeCode" headertext="MRN" description="" />
    </intellisensetexts>
  </searchdialog>
  <!-- #EndRegion -->
  <!-- #Region Zip Codes -->
  <searchdialog type="zipcodes" methodname="GetZipCodesList" keyfieldname="ZipCode">
    <gridcolumns>
      <gridcolumn datafield="ZipCode" headertext="Kode Pos" width="100px" />
      <gridcolumn datafield="StreetName" headertext="Jalan" width="200px" />
      <gridcolumn datafield="District" headertext="Desa / Kelurahan" width="200px" />
      <gridcolumn datafield="County" headertext="Kecamatan" width="200px" />
      <gridcolumn datafield="City" headertext="Kota" width="200px" />
    </gridcolumns>
    <intellisensetexts>
      <intellisensetext datafield="City" headertext="Kota" description="" />
      <intellisensetext datafield="ZipCode" headertext="Kode Pos" description="" />
      <intellisensetext datafield="StreetName" headertext="Jalan" description="" />
      <intellisensetext datafield="District" headertext="Desa / Kelurahan" description="" />
      <intellisensetext datafield="County" headertext="Kecamatan" description="" />
    </intellisensetexts>
  </searchdialog>
