<?xml version="1.0" encoding="utf-8" ?>
<root>
  <table datasource="GetvPurchaseOrderDtList" datasourcehd="GetvPurchaseOrderHdList" custompadding="0.2cm 1.3cm" filterexpressionhd="" headertext="SURAT PESANAN BARANG" filterexpression="IsDeleted = 0" papertype="A4_portrait" fontsize="9pt"/>
  <parameters>
    <parameter code="FP001"/>
  </parameters>
  <fields>
    <field fieldtype="autonumber" headertext="No" width="5"/>
    <field fieldname="ItemName1" headertext="Item"/>
    <field fieldname="Quantity" headertext="Quantity" width="10" fieldtype="number"/>
    <field fieldname="PurchaseUnit" headertext="Satuan" width="10" />
    <field fieldname="UnitPrice" headertext="Harga" width="15" fieldtype="currency"/>
    <field fieldname="DiscountPercentage1" headertext="Disc 1" width="10" fieldtype="currency"/>
    <field fieldname="DiscountPercentage2" headertext="Disc 2" width="10" fieldtype="currency"/>
    <field fieldname="LineAmount" headertext="Total" width="15" fieldtype="currency"/>
  </fields>
  <headertemplate>
    <![CDATA[
    <table style="width:100%" cellspacing="0" cellpadding="0">
      <colgroup>
        <col style="width:50%"/>
      </colgroup>
      <tr>
        <td valign="top">
          <table cellspacing="0" cellpadding="0">
            <colgroup>
              <col style="width:70px"/>
              <col style="width:20px"/>
            </colgroup>      
            <tr><td>To</td><td align="center">:</td><td>{BusinessPartnerName}</td></tr>
            <tr><td>Attn.</td><td align="center">:</td><td>{ContactPerson}</td></tr>
            <tr><td>Telp.</td><td align="center">:</td><td>{PhoneNo1}</td></tr>
            <tr><td>Hp.</td><td align="center">:</td><td>{ContactPersonMobilePhoneNo}</td></tr>
            <tr><td>Fax.</td><td align="center">:</td><td>{FaxNo1}</td></tr>
            <tr><td>E-mail</td><td align="center">:</td><td>{EmailAddress1}</td></tr>
          </table>
        </td>
        <td valign="top" align="right">
          <table cellspacing="0" cellpadding="0">
            <colgroup>
              <col style="width:70px"/>
              <col style="width:20px"/>
            </colgroup>      
            <tr><td>No.</td><td align="center">:</td><td>{PurchaseOrderNo}</td></tr>
            <tr><td>Date</td><td align="center">:</td><td>{OrderDateInString}</td></tr>
          </table>
        </td>
      </tr>
    </table>
    ]]>
  </headertemplate>
  <footertemplate>
    <![CDATA[
     <table style="width:100%" cellspacing="0" cellpadding="0">
      <colgroup>
        <col style="width:50%"/>
      </colgroup>
      <tr>
        <td colspan="2" style="padding-top:0.5cm">&nbsp;</td>
      </tr>
      <tr>
        <td valign="top" rowspan="3"><div style="word-wrap: break-word; white-space: normal">{cfRemarks}</div></td>
        <td valign="top" align="center">Dibuat Oleh</td>
      </tr>
      <tr>
        <td class="tdSignature">&nbsp;</td>
      </tr>
      <tr>
        <td valign="top" align="center">
          <div style="border-bottom:1px solid;width:120px;">{CreatedByName}</div>
        </td>
      </tr>
    </table>
    ]]>
  </footertemplate>
</root>