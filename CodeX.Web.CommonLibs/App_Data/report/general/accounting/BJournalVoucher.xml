<?xml version="1.0" encoding="utf-8" ?>
<root>
  <table datasource="GetvGLTransactionDtCustomList" datasourcehd="GetvGLTransactionHdList" filterexpressionhd="" headertext="JOURNAL VOUCHER" filterexpression="IsDeleted  = 0 AND GCItemDetailStatus != 'X121^999' ORDER BY DisplayOrder ASC" papertype="A5_portrait" fontsize="8pt" isshowtotal="1" totaltext="Total" />
  <parameters>
    <parameter code="FP001"/>
  </parameters>
  <fields>
    <field fieldtype="autonumber" headertext="No" width="3"/>
    <field fieldname="AccountForJournalVoucher" headertext="Perkiraan dan Keterangan"/>
    <field fieldname="GLAccountNo" headertext="No Perkiraan" width="15"/>
    <field fieldname="DebitAmount" headertext="Debit" width="13" fieldtype="currency" isshowsubtotal="1"/>
    <field fieldname="CreditAmount" headertext="Kredit" width="13" fieldtype="currency" isshowsubtotal="1"/>
  </fields>
  <headertemplate>
    <![CDATA[
    <table style="width:100%" cellspacing="0" cellpadding="0">
      <colgroup>
        <col style="width:60%"/>
      </colgroup>
      <tr>
        <td valign="top">
          <table cellspacing="0" cellpadding="0">
            <colgroup>
              <col style="width:110px"/>
              <col style="width:20px"/>
            </colgroup>      
            <tr><td>No Voucher</td><td align="center">:</td><td>{JournalNo}</td></tr>
            <tr><td>Tanggal Voucher</td><td align="center">:</td><td>{JournalDateInString}</td></tr>
          </table>
        </td>
        <td valign="top">
          <table cellspacing="0" cellpadding="0">
            <colgroup>
              <col style="width:110px"/>
              <col style="width:20px"/>
            </colgroup>      
            <tr><td>Keterangan</td><td align="center">:</td><td>{Remarks}</td></tr>
          </table>
           	
        </td>
      </tr>
    </table>
    ]]>
  </headertemplate>
  <footertemplate>
    <![CDATA[
     <table style="width:100%" cellspacing="0" cellpadding="0">
      <colgroup>
        <col style="width:25%"/>
      </colgroup>
      <tr>
        <td colspan="2" style="padding-top:0.5cm">&nbsp;</td>
      </tr>
      <tr>
        <td valign="top" align="center">Direktur</td>
        <td valign="top" align="center">Bagian Keuangan</td>
        <td valign="top" align="center">Bag. Pembukuan</td>
        <td valign="top" align="center">{LastUpdatedDateInString}</td>
      </tr>
      <tr>
        <td valign="top" align="center">Menyetujui</td>
        <td valign="top" align="center">Diperiksa</td>
        <td valign="top" align="center">Dibukukan</td>
        <td valign="top" align="center">Dibuat Oleh</td>
      </tr>
      <tr>
        <td colspan="2" class="tdSignature">&nbsp;</td>
      </tr>
      <tr>
        <td valign="top" align="center">
          <div style="border-bottom:1px solid;width:120px;">&nbsp;</div></br>
        </td>
        <td valign="top" align="center">
          <div style="border-bottom:1px solid;width:120px;">&nbsp;</div></br>
        </td>
        <td valign="top" align="center"><div style="border-bottom:1px solid;width:120px;">{LastUpdatedByName}</div></td>
        <td valign="top" align="center"><div style="border-bottom:1px solid;width:120px;">{CreatedByName}</div></td>
      </tr>
    </table>
    ]]>
  </footertemplate>
</root>