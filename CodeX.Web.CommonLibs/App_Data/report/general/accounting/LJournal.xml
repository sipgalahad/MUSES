<?xml version="1.0" encoding="utf-8" ?>
<root>
  <table datasource="GetvGLTransactionDtList" headertext="Laporan Journal" filterexpression="IsDeleted = 0 AND GCItemDetailStatus NOT IN ('X121^999','X121^001')" papertype="A4_landscape" fontsize="8pt" isshowtotal="1" totaltext="Grand Total" subheadertext="{DT002}"/>
  <parameters>
    <parameter code="DT002"/>
  </parameters>
  <groups>
    <group fieldname="JournalDateInMonth" orderby="JournalDateInMonth" orderbytype="ASC" headertext="Bulan : [GroupName]" isshowsubtotal="1" subtotaltext="Total Bulan : [GroupName]" />
    <group fieldname="TransactionName" orderby="TransactionName" orderbytype="ASC" headertext="Tipe Jurnal : [GroupName]" />
    <group fieldname="JournalNo" orderby="JournalNo" orderbytype="ASC" headertext="No Jurnal : [GroupName]" />
  </groups>
  <fields>
    <field fieldname="GLAccountNo" headertext="Kd. Akun" width="8" />
    <field fieldname="GLAccountName" headertext="Nama Akun" />
    <field fieldname="DebitAmount" headertext="Debet" width="8" fieldtype="currency" isshowsubtotal="1" />
    <field fieldname="CreditAmount" headertext="Kredit" width="8" fieldtype="currency" isshowsubtotal="1" />
  </fields>
</root>
