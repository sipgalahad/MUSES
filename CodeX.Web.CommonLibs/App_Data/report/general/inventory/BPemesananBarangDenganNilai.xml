<?xml version="1.0" encoding="utf-8" ?>
<root>
  <table datasource="GetvPurchaseOrderDtList" datasourcehd="GetvPurchaseOrderHdList" custompadding="0.2cm 1.3cm" filterexpressionhd="" headertext="" subheadertext="Dengan Nilai" isshowheaderfooter="0" filterexpression="IsDeleted = 0" papertype="A4_portrait" fontsize="8pt"/>
  <parameters>
    <parameter code="FP001"/>
  </parameters>
  <fields>
    <field fieldtype="autonumber" headertext="No" width="3"/>
    <field fieldname="ItemName1" headertext="Item"/>
    <field fieldname="Quantity" headertext="Quantity" width="10" fieldtype="number"/>
    <field fieldname="UnitPrice" headertext="Harga" width="15" fieldtype="currency"/>
    <field fieldname="DiscountPercentage1" headertext="Disc 1" width="10" fieldtype="currency"/>
    <field fieldname="DiscountPercentage2" headertext="Disc 2" width="10" fieldtype="currency"/>
    <field fieldname="LineAmount" headertext="Total" width="15" fieldtype="currency"/>
  </fields>
  <headertemplate>
    <![CDATA[
    <div style="margin-top:150px;"></div>
    <center><h1>SURAT PESANAN BARANG</h1></center><br style="display: none" />
    <center><h2>Dengan Nilai</h2></center><br style="display: none" />
    <table style="width:100%" cellspacing="0" cellpadding="0">
      <colgroup>
        <col style="width:60%"/>
      </colgroup>
      <tr>
        <td valign="top">
          Kepada :<br/>
          <b>{BusinessPartnerName}</b>
        </td>
        <td valign="top">
          <table cellspacing="0" cellpadding="0">
            <colgroup>
              <col style="width:110px"/>
              <col style="width:20px"/>
            </colgroup>      
            <tr><td>No Pemesanan</td><td align="center">:</td><td>{PurchaseOrderNo}</td></tr>
            <tr><td>Tanggal Pemesanan</td><td align="center">:</td><td>{OrderDateInString}</td></tr>
            <tr><td>Kode Supplier</td><td align="center">:</td><td>{BusinessPartnerCode}</td></tr>
          </table>
           	
        </td>
      </tr>
    </table>
    ]]>
  </headertemplate>
  <footertemplate>
    <![CDATA[
     <table style="width:100%;" cellspacing="0" cellpadding="0">
       <tr>
        <td align="right" class="tdReportTotal">
          <table>
            <colgroup>
             <col style="width:90px"/>
             <col style="width:5px"/>
             <col style="width:60px"/>
            </colgroup> 
            <tr>
              <td>Total</td>
              <td>:</td>
              <td align="right">{TransactionAmount,N}</td>
            </tr>
          </table>          
        </td>
       </tr>
     </table>
     <table style="width:100%" cellspacing="0" cellpadding="0">
      <colgroup>
        <col style="width:50%"/>
      </colgroup>
      <tr>
        <td colspan="2" style="padding-top:0.5cm">&nbsp;</td>
      </tr>
      <tr>
        <td valign="top" align="center">Dibuat Oleh</td>
        <td valign="top" align="center">Disetujui Oleh</td>
      </tr>
      <tr>
        <td colspan="2" class="tdSignature">&nbsp;</td>
      </tr>
      <tr>
        <td valign="top" align="center"><div style="border-bottom:1px solid;width:120px;">{CreatedByName}</div></td>
        <td valign="top" align="center">
          <div style="border-bottom:1px solid;width:120px;">&nbsp;</div></br>
        </td>
      </tr>
    </table>
    ]]>
  </footertemplate>
</root>