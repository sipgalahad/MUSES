<?xml version="1.0" encoding="utf-8" ?>
<root>
  <table datasource="GetvItemTransactionDtList" datasourcehd="GetvItemTransactionHdList" filterexpressionhd="" headertext="Bukti Pemakaian Barang" filterexpression="GCItemDetailStatus != 'X121^999'" papertype="A4_portrait" fontsize="8pt" />
  <parameters>
    <parameter code="FP001"/>
  </parameters>
  <fields>
    <field fieldtype="autonumber" headertext="No" width="4"/>
    <field fieldname="ItemCode" width="15" headertext="Kode Barang"/>
    <field fieldname="ItemName1" headertext="Nama Barang"/>
    <field headertext="Quantity" width="10" fieldtype="customfield" align="right">
      <![CDATA[
        {Quantity} {ItemUnit}
      ]]>
    </field>
  </fields>
  <headertemplate>
    <![CDATA[
    <table style="width:100%" cellspacing="0" cellpadding="0">
      <colgroup>
        <col style="width:60%"/>
      </colgroup>
      <tr>
        <td valign="top">
          <table cellspacing="0" cellpadding="0">
            <colgroup>
              <col style="width:110px"/>
              <col style="width:20px"/>
            </colgroup>      
            <tr><td>No Pemakaian</td><td align="center">:</td><td>{TransactionNo}</td></tr>
            <tr><td>Tanggal Pemakaian</td><td align="center">:</td><td>{TransactionDateInString}</td></tr>
            <tr><td>Lokasi</td><td align="center">:</td><td>{FromLocationName}</td></tr>
            <tr><td>Bagian</td><td align="center">:</td><td>{ServiceUnitName}</td></tr>
          </table>
        </td>
        <td valign="top">
          <table cellspacing="0" cellpadding="0">
            <colgroup>
              <col style="width:110px"/>
              <col style="width:20px"/>
            </colgroup>      
            <tr><td>Catatan</td><td align="center">:</td><td>{Remarks}</td></tr>
          </table>
        </td>
      </tr>
    </table>
    ]]>
  </headertemplate>
  <footertemplate>
    <![CDATA[
     <table style="width:100%" cellspacing="0" cellpadding="0">
      <colgroup>
        <col style="width:50%"/>
      </colgroup>
      <tr>
        <td colspan="2" style="padding-top:0.5cm">&nbsp;</td>
      </tr>
      <tr>
        <td valign="top" align="center">Dibuat Oleh</td>
        <td valign="top" align="center">Diterima Oleh</td>
      </tr>
      <tr>
        <td colspan="2" class="tdSignature">&nbsp;</td>
      </tr>
      <tr>
        <td valign="top" align="center"><div style="border-bottom:1px solid;width:120px;">{CreatedByName}</div></td>
        <td valign="top" align="center">
          <div style="border-bottom:1px solid;width:120px;">&nbsp;</div></br>
        </td>
      </tr>
    </table>
    ]]>
  </footertemplate>
</root>