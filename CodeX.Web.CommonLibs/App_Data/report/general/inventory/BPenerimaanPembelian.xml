<?xml version="1.0" encoding="utf-8" ?>
<root>
  <table datasource="GetvPurchaseReceiveDtList" datasourcehd="GetvPurchaseReceiveHdList" filterexpressionhd="" headertext="BUKTI PENERIMAAN PEMBELIAN" filterexpression="GCItemDetailStatus != 'X121^999'" papertype="F5_portrait" fontsize="8pt" noofprintcopy="1"/>
  <parameters>
    <parameter code="FP001"/>
  </parameters>
  <fields>
    <field fieldtype="autonumber" headertext="No" width="4"/>
    <field fieldname="ItemName1" headertext="Item"/>
    <field fieldname="Quantity" headertext="Quantity" width="10" fieldtype="number"/>
    <field fieldname="ItemUnit" headertext="Satuan" width="10"/>
    <field fieldname="UnitPrice" headertext="Harga" width="15" fieldtype="currency"/>
    <field fieldname="DiscountPercentage1" headertext="Disc 1" width="10" fieldtype="currency"/>
    <field fieldname="DiscountPercentage2" headertext="Disc 2" width="10" fieldtype="currency"/>
    <field fieldname="LineAmount" headertext="Total" width="15" fieldtype="currency"/>
  </fields>
  <headertemplate>
    <![CDATA[
    <table style="width:100%" cellspacing="0" cellpadding="0">
      <colgroup>
        <col style="width:50%"/>
      </colgroup>
      <tr>
        <td valign="top">
          <table cellspacing="0" cellpadding="0">
            <colgroup>
              <col style="width:110px"/>
              <col style="width:20px"/>
            </colgroup>      
            <tr><td>No Penerimaan</td><td align="center">:</td><td>{PurchaseReceiveNo}</td></tr>
            <tr><td>Tanggal Penerimaan</td><td align="center">:</td><td>{ReceivedDateInString}</td></tr>
            <tr><td>Bagian</td><td align="center">:</td><td>{ServiceUnitName}</td></tr>
            <tr><td>Lokasi</td><td align="center">:</td><td>{LocationName}</td></tr>
          </table>
        </td>
        <td valign="top">
          <table cellspacing="0" cellpadding="0">
            <colgroup>
              <col style="width:110px"/>
              <col style="width:20px"/>
            </colgroup>      
            <tr><td>Supplier</td><td align="center">:</td><td>{SupplierName}</td></tr>
            <tr><td>Bank</td><td align="center">:</td><td>{Bank}</td></tr>
            <tr><td>No Rekening</td><td align="center">:</td><td>{BankReferenceNo}</td></tr>
            <tr><td>Nama Pemegang</td><td align="center">:</td><td>{BankAccountHolder}</td></tr>
          </table>
        </td>
      </tr>
    </table>
    ]]>
  </headertemplate>
  <footertemplate>
    <![CDATA[
     <table style="width:100%;" cellspacing="0" cellpadding="0">
       <tr>
        <td align="right" class="tdReportTotal">
          <table>
            <colgroup>
             <col style="width:90px"/>
             <col style="width:5px"/>
             <col style="width:60px"/>
            </colgroup> 
            <tr>
              <td>DPP</td>
              <td>:</td>
              <td align="right">{TransactionAmount,N}</td>
            </tr>
            <tr>
              <td>Diskon Final</td>
              <td>:</td>
              <td align="right">{FinalDiscountAmount,N}</td>
            </tr>
            <tr>
              <td>PPN</td>
              <td>:</td>
              <td align="right">{VATAmount,N}</td>
            </tr>
            <tr>
              <td>Total</td>
              <td>:</td>
              <td align="right">{TotalNetTransactionAmount,N}</td>
            </tr>
          </table>          
        </td>
       </tr>
     </table>
     <table style="width:100%" cellspacing="0" cellpadding="0">
      <colgroup>
        <col style="width:50%"/>
      </colgroup>
      <tr>
        <td colspan="2" valign="top"><div style="word-wrap: break-word; white-space: normal">{cfRemarks}</div></td>
      </tr>
      <tr>
        <td colspan="2" style="padding-top:0.5cm">&nbsp;</td>
      </tr>
      <tr>
        <td valign="top" align="center">Dibuat Oleh</td>
        <td valign="top" align="center">Diterima Oleh</td>
      </tr>
      <tr>
        <td colspan="2" class="tdSignature">&nbsp;</td>
      </tr>
      <tr>
        <td valign="top" align="center"><div style="border-bottom:1px solid;width:120px;">{CreatedByName}</div></td>
        <td valign="top" align="center">
          <div style="border-bottom:1px solid;width:120px;">&nbsp;</div></br>
        </td>
      </tr>
    </table>
    ]]>
  </footertemplate>
</root>