<?xml version="1.0" encoding="utf-8" ?>
<root>
  <table datasource="GetvPurchaseOrderDtList" headertext="Laporan Pemesanan Barang" filterexpression="GCItemDetailStatus != 'X121^999'" papertype="A4_portrait" fontsize="9pt"/>
  <parameters>
    <parameter code="DT007" isshowassubtitle="1"/>
  </parameters>
  <groups>
    <group fieldname="PurchaseOrderNo" orderby="PurchaseOrderNo" orderbytype="ASC" headertext="No. PO: [GroupName]" />
  </groups>
  <fields>
    <field fieldtype="autonumber" headertext="No" width="3"/>
    <field fieldname="ItemCode" headertext="Kode" width="10"/>
    <field fieldname="ItemName1" headertext="Nama" />
    <field headertext="Quantity" width="10" fieldtype="customfield" align="right">
      <![CDATA[
        {Quantity} {PurchaseUnit}
      ]]>
    </field>
    <field fieldname="UnitPrice" headertext="Harga" width="10" fieldtype="currency"/>
    <field fieldname="DiscountPercentage1" headertext="Disc1 %" width="10" fieldtype="currency"/>
    <field fieldname="DiscountPercentage2" headertext="Disc2 %" width="10" fieldtype="currency"/>
    <field fieldname="LineAmount" headertext="Total" width="15" fieldtype="currency" isshowsubtotal="1"/>
  </fields>
</root>