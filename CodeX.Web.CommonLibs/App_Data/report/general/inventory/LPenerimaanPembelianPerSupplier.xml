<?xml version="1.0" encoding="utf-8" ?>
<root>
  <table datasource="GetvPurchaseReceiveDtList" headertext="Laporan Penerimaan Pembelian Per Supplier" filterexpression="GCItemDetailStatus != 'X121^999'" papertype="A4_portrait" fontsize="9pt" isshowtotal="1" totaltext="Total : "/>
  <parameters>
    <parameter code="DT006" isshowassubtitle="1"/>
    <parameter code="CB001" isshowassubtitle="1" isrequired="1"/>
    <parameter code="SD006" isshowassubtitle="1" isrequired="1"/>
  </parameters>
  <groups>
    <group fieldname="ReceivedDateInString" orderby="ReceivedDate" orderbytype="ASC" headertext="Tanggal: [GroupName]" isshowsubtotal="1" subtotaltext="Sub Total [GroupName] : "  />
    <group fieldname="PurchaseReceiveNo" orderby="PurchaseReceiveNo" orderbytype="ASC" headertext="No Transaksi : [GroupName]" isshowsubtotal="1" subtotaltext="Sub Total [GroupName] : "  />
  </groups>
  <fields>
    <field fieldtype="autonumber" headertext="No" width="3"/>
    <field fieldname="ItemCode" headertext="Kode" width="10"/>
    <field fieldname="ItemName1" headertext="Nama" />
    <field headertext="Quantity" width="10" fieldtype="customfield" align="right">
      <![CDATA[
        {Quantity} {ItemUnit}
      ]]>
    </field>
    <field fieldname="UnitPrice" headertext="Harga" width="15" fieldtype="currency"/>
    <field fieldname="DiscountPercentage1" headertext="Disc 1" width="10" fieldtype="currency"/>
    <field fieldname="DiscountPercentage2" headertext="Disc 2" width="10" fieldtype="currency"/>
    <field fieldname="LineAmount" headertext="Total" width="15" fieldtype="currency" isshowsubtotal="1"/>
  </fields>
</root>