<?xml version="1.0" encoding="utf-8" ?>
<root>
  <table datasource="GetvPurchaseRequestDtList" datasourcehd="GetvPurchaseRequestHdList" filterexpressionhd="" headertext="" filterexpression="IsDeleted = 0" papertype="A4_portrait" fontsize="8pt" isshowheaderfooter="0" isshowtotal="1" totaltext="Total : "/>
  <parameters>
    <parameter code="FP001"/>
  </parameters>
  <fields>
    <field fieldtype="autonumber" headertext="No" width="3"/>
    <field fieldname="ItemName1" headertext="Item"/>
    <field headertext="Quantity" width="10" fieldtype="customfield" align="right">
      <![CDATA[
        {Quantity} {PurchaseUnit}
      ]]>
    </field>
    <field headertext="Harga" width="10" fieldtype="customfield" align="right">
      <![CDATA[
        {UnitPrice,N} / {PurchaseUnit}
      ]]>
    </field>
    <field fieldname="DiscountPercentage" headertext="Disc 1" width="10" fieldtype="currency"/>
    <field fieldname="CustomTotalPrice" headertext="Total" width="15" fieldtype="currency" isshowsubtotal="1"/>
  </fields>
  <headertemplate>
    <![CDATA[
    <div style="margin-top:150px;"></div>
    <center><h1>Bukti Permintaan Pembelian</h1></center><br style="display: none" />
    <table style="width:100%" cellspacing="0" cellpadding="0">
      <colgroup>
        <col style="width:60%"/>
      </colgroup>
      <tr>
        <td valign="top">
          <table cellspacing="0" cellpadding="0">
            <colgroup>
              <col style="width:110px"/>
              <col style="width:20px"/>
            </colgroup>      
            <tr><td>No Permintaan</td><td align="center">:</td><td>{PurchaseRequestNo}</td></tr>
            <tr><td>Lokasi</td><td align="center">:</td><td>{LocationName}</td></tr>
          </table>
        </td>
        <td valign="top">
          <table cellspacing="0" cellpadding="0">
            <colgroup>
              <col style="width:110px"/>
              <col style="width:20px"/>
            </colgroup>      
            <tr><td>Tanggal Permintaan</td><td align="center">:</td><td>{TransactionDateInString}</td></tr>
          </table>           	
        </td>
      </tr>
    </table>
    ]]>
  </headertemplate>
  <footertemplate>
    <![CDATA[
     <table style="width:100%" cellspacing="0" cellpadding="0">
      <colgroup>
        <col style="width:50%"/>
      </colgroup>
      <tr>
        <td colspan="2" style="padding-top:0.5cm">&nbsp;</td>
      </tr>
      <tr>
        <td valign="top" align="center">Dibuat Oleh</td>
        <td valign="top" align="center">Disetujui Oleh</td>
      </tr>
      <tr>
        <td colspan="2" class="tdSignature">&nbsp;</td>
      </tr>
      <tr>
        <td valign="top" align="center"><div style="border-bottom:1px solid;width:120px;">{CreatedByName}</div></td>
        <td valign="top" align="center">
          <div style="border-bottom:1px solid;width:120px;">&nbsp;</div></br>
        </td>
      </tr>
    </table>
    ]]>
  </footertemplate>
</root>