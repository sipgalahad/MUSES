<?xml version="1.0" encoding="utf-8" ?>
<root>
  <table datasource="GetvItemDistributionDtList" datasourcehd="GetvItemDistributionHdList" filterexpressionhd="" headertext="Bukti Distribusi Barang" filterexpression="IsDeleted = 0" papertype="A4_portrait" fontsize="8pt" />
  <parameters>
    <parameter code="FP001"/>
  </parameters>
  <fields>
    <field fieldtype="autonumber" headertext="No" width="4"/>
    <field fieldname="ItemCode" width="10" headertext="Kode"/>
    <field fieldname="ItemName1" headertext="Item"/>
    <field headertext="Quantity" width="15" fieldtype="customfield" align="right">
      <![CDATA[
        {Quantity} {ItemUnit}
      ]]>
    </field>
  </fields>
  <headertemplate>
    <![CDATA[
    <table style="width:100%" cellspacing="0" cellpadding="0">
      <colgroup>
        <col style="width:60%"/>
      </colgroup>
      <tr>
        <td valign="top">
          <table cellspacing="0" cellpadding="0">
            <colgroup>
              <col style="width:110px"/>
              <col style="width:20px"/>
            </colgroup>      
            <tr><td>No Distribusi</td><td align="center">:</td><td>{DistributionNo}</td></tr>
            <tr><td>Tanggal Distribusi</td><td align="center">:</td><td>{DeliveryDateInString}</td></tr>
          </table>
        </td>
        <td valign="top">
          <table cellspacing="0" cellpadding="0">
            <colgroup>
              <col style="width:110px"/>
              <col style="width:20px"/>
            </colgroup>      
            <tr><td>Dari Lokasi</td><td align="center">:</td><td>{FromLocationName}</td></tr>
            <tr><td>Ke Lokasi</td><td align="center">:</td><td>{ToLocationName}</td></tr>
          </table>           	
        </td>
      </tr>
    </table>
    ]]>
  </headertemplate>
  <footertemplate>
    <![CDATA[
       <table style="width:100%" cellspacing="0" cellpadding="0">
        <colgroup>
          <col style="width:50%"/>
        </colgroup>
        <tr>
          <td colspan="2" valign="top"><div style="word-wrap: break-word; white-space: normal">{cfDeliveryRemarks}</div></td>
        </tr>
        <tr>
          <td colspan="2" style="padding-top:0.5cm">&nbsp;</td>
        </tr>
        <tr>
          <td valign="top" align="center">Dibuat Oleh</td>
          <td valign="top" align="center">Diterima Oleh</td>
        </tr>
        <tr>
          <td colspan="2" class="tdSignatureSmall">&nbsp;</td>
        </tr>
        <tr>
          <td valign="top" align="center"><div style="border-bottom:1px solid;width:120px;">&nbsp;</div></td>
          <td valign="top" align="center">
            <div style="border-bottom:1px solid;width:120px;">&nbsp;</div></br>
          </td>
        </tr>
      </table>
    ]]>
  </footertemplate>
</root>