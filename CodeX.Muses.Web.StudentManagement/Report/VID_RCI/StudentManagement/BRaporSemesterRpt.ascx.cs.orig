                HtmlTableCell tdSchoolPeriod2 = e.Item.FindControl("tdSchoolPeriod2") as HtmlTableCell;
                HtmlTableCell tdSchoolName2 = e.Item.FindControl("tdSchoolName2") as HtmlTableCell;

