<?xml version="1.0"?>
<configuration>
  <appSettings configSource="AppSetting.config"/>
  <connectionStrings configSource="ConnectionString.config"/>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="SyncServiceSoap"/>
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint address="http://localhost/publish2/Muses/ControlPanelHQ/Program/SyncService/SyncService.asmx" binding="basicHttpBinding" bindingConfiguration="SyncServiceSoap" contract="SyncService.SyncServiceSoap" name="SyncServiceSoap"/>
    </client>
  </system.serviceModel>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/></startup></configuration>
